# These values are intentionally blank. Do not share a filled .env.
TG_BOT_TOKEN=
TG_CHANNEL_ID=
TG_PROXY_URL=
# Real Telegram send needs this to be 1 AND `send --confirm <fingerprint>`. TG_CHANNEL_ID, if set, must be -1001234567890.
TG_ALLOW_LIVE_SEND=0
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Real image generation needs this to be 1 AND dry_run=false in the MCP tool call.
CF_ALLOW_LIVE_GENERATION=0
# Optional http(s) proxy for Cloudflare requests, e.g. http://user:pass@host:port. Empty = direct connection.
PROXY_URL=
